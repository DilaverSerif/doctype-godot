[configuration]

entry_symbol = "doctype_library_init"
compatibility_minimum = "4.7"

[libraries]

macos.debug = "res://addons/doctype/bin/libdoctype.macos.template_debug.framework"
macos.release = "res://addons/doctype/bin/libdoctype.macos.template_release.framework"
windows.debug.x86_64 = "res://addons/doctype/bin/libdoctype.windows.template_debug.x86_64.dll"
windows.release.x86_64 = "res://addons/doctype/bin/libdoctype.windows.template_release.x86_64.dll"
linux.debug.x86_64 = "res://addons/doctype/bin/libdoctype.linux.template_debug.x86_64.so"
linux.release.x86_64 = "res://addons/doctype/bin/libdoctype.linux.template_release.x86_64.so"
linux.debug.arm64 = "res://addons/doctype/bin/libdoctype.linux.template_debug.arm64.so"
linux.release.arm64 = "res://addons/doctype/bin/libdoctype.linux.template_release.arm64.so"
android.debug.arm64 = "res://addons/doctype/bin/libdoctype.android.template_debug.arm64.so"
android.release.arm64 = "res://addons/doctype/bin/libdoctype.android.template_release.arm64.so"
ios.debug = "res://addons/doctype/bin/libdoctype.ios.template_debug.a"
ios.release = "res://addons/doctype/bin/libdoctype.ios.template_release.a"
